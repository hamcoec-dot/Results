{
  "name": "hcec-election-results-functions",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "src/index.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:pr": "c8 --check-coverage node --test test/*.test.js",
    "test:nightly": "cross-env FC_RUNS=100000 node --test test/*.property.test.js",
    "golden": "python ../tools/make_golden.py",
    "mutation": "cross-env FC_RUNS=30 stryker run",
    "test:emulator": "cd .. && npx --yes firebase-tools@13.35.1 emulators:exec --project demo-hcec --only auth,firestore,storage,functions \"node --test functions/test/emulator/rules.test.js functions/test/emulator/integration.test.js\""
  },
  "dependencies": {
    "csv-parse": "7.0.2",
    "firebase-admin": "13.10.0",
    "firebase-functions": "6.6.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/tap-runner": "10.0.0",
    "c8": "10.1.3",
    "cross-env": "7.0.3",
    "fast-check": "3.23.2",
    "firebase": "12.19.0"
  },
  "overrides": {
    "qs": "6.16.2",
    "uuid": "11.1.1",
    "@grpc/grpc-js": "1.14.5"
  }
}
