rules_version = '2';
// Every write goes through the Cloud Functions (Admin SDK, bypasses these rules).
// Clients read: admins see election data; a signed-in user may read only their own admins doc
// (that is how admin.html learns whether to show "not authorised").
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // Console only
    }

    match /elections/{eid} {
      allow read: if isAdmin();
      allow write: if false;
      match /{sub=**} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    match /audit/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Anything not listed above: nobody.
    match /{other=**} {
      allow read, write: if false;
    }
  }
}
